# Firebase Web App Configuration
# ================================
# REQUIRED: Get these values from Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Select your project
# 3. Project Settings → General → "Your apps" → Web app config
# 4. Copy the exact values from your Firebase project config:

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase Admin SDK Configuration
# =============================================
# REQUIRED: Get the service account key from Firebase Console:
# 1. Project Settings → Service Accounts
# 2. Click "Generate new private key" → save the JSON file
# 3. Place it at: c:\Yashwanth\WorkSetup\NodeJS\serviceAccountKey.json
# 4. Or update the path below to match your file location

GOOGLE_APPLICATION_CREDENTIALS=c:\Yashwanth\WorkSetup\NodeJS\serviceAccountKey.json

# Development Mode Admin Bypass (TEMPORARY - FOR DEVELOPMENT ONLY)
# ================================================================
# Set to 'true' to automatically log in as admin without Firebase
# This bypasses the entire Firebase Auth flow for testing
# WARNING: ONLY for local development - NEVER use in production!
# Once ready, set to 'false' and implement proper authentication

VITE_DEV_ADMIN=false